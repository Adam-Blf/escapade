# Toutes les clés sont OPTIONNELLES et GRATUITES : sans elles, l'app
# fonctionne sur le catalogue statique.

# API SNCF (Navitia) · durées de trajet en temps réel.
# Compte gratuit (5000 req/jour) : https://numerique.sncf.com/startup/api/
SNCF_API_KEY=

# Amadeus Self-Service (environnement test, gratuit) · prix hôtels live.
# Compte : https://developers.amadeus.com → Create app → Test keys
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# Stripe Payment Link pour l'option don (créé dans le dashboard Stripe,
# aucun coût fixe). Bouton masqué si absent.
NEXT_PUBLIC_STRIPE_DONATION_URL=
